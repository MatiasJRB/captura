// Copy to Captura.local.xcconfig (same folder). That copy is git-ignored.
// Never commit real values. Do not put "//" inside a value: it starts a comment.

// A bundle identifier unique to you, e.g. com.yourname.captura.
// It must match the bundle ID of your Google "iOS" OAuth client.
CAPTURA_BUNDLE_ID = com.example.captura

// Your Apple team ID (a free Personal Team works). Set it here, not with the Team
// menu in Xcode's Signing & Capabilities tab: that menu writes the ID into the tracked
// ios/Captura.xcodeproj/project.pbxproj, and a later `git pull` then stops on it.
// To find a Personal Team ID: pick the team in that menu once, copy the value of
// DEVELOPMENT_TEAM from `git diff ios/Captura.xcodeproj/project.pbxproj`, paste it here,
// then undo the project change with `git checkout -- ios/Captura.xcodeproj/project.pbxproj`.
CAPTURA_DEVELOPMENT_TEAM =

// From your Google Cloud "iOS" OAuth client (Client ID and iOS URL scheme).
CAPTURA_GOOGLE_IOS_CLIENT_ID = 000000000000-example.apps.googleusercontent.com
CAPTURA_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-example

// Optional: only offer accounts of this Google Workspace domain, e.g. example.com.
CAPTURA_GOOGLE_HOSTED_DOMAIN =
